{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"files": {
		"includes": [
			"typescript/**",
			"tsconfig.json",
			".claude-plugin/**",
			".codex-plugin/**",
			".mcp.json",
			"hooks/hooks.json",
			"package.json",
			"biome.json",
			"bootstrap/**"
		]
	},
	"linter": {
		"rules": {
			"complexity": {
				"noImportantStyles": "off"
			}
		}
	}
}
