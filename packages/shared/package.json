{
  "name": "@grainulation/grainulator-shared",
  "version": "3.2.0",
  "description": "Shared sprint utilities and filesystem safety",
  "license": "MIT",
  "author": "grainulation contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grainulation/grainulator.git"
  },
  "homepage": "https://grainulator.dev",
  "bugs": {
    "url": "https://github.com/grainulation/grainulator/issues"
  },
  "keywords": [
    "evidence",
    "grainulation",
    "sprints",
    "structured-research",
    "developer-tools"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./detect-sprints": "./tools/detect-sprints.js",
    "./generate-manifest": "./tools/generate-manifest.js",
    "./mcp": {
      "import": "./lib/mcp.js",
      "require": "./lib/mcp.cjs"
    },
    "./mcp-crash": {
      "import": "./lib/mcp-crash.js",
      "require": "./lib/mcp-crash.cjs"
    },
    "./paths": {
      "import": "./lib/paths.js",
      "require": "./lib/paths.cjs"
    },
    "./atomic": {
      "import": "./lib/atomic.js",
      "require": "./lib/atomic.cjs"
    },
    "./cli": {
      "import": "./lib/cli.js",
      "require": "./lib/cli.cjs"
    },
    "./phases": {
      "import": "./lib/phases.js",
      "require": "./lib/phases.cjs"
    },
    "./sprints": {
      "import": "./lib/sprints.js",
      "require": "./lib/sprints.cjs"
    },
    "./transaction": "./lib/transaction.js"
  },
  "files": [
    "bin/",
    "lib/",
    "tools/",
    "CHANGELOG.md",
    "LICENSE",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node bin/shared.js --help",
    "test": "node test/basic.test.js && node --test test/shared-utils.test.js test/mcp-crash.test.js test/tarball.test.js && node --test test/dashboard-retirement.test.js",
    "format": "npx prettier@3.3 --write .",
    "format:check": "npx prettier@3.3 --check ."
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
