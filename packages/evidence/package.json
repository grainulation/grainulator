{
  "name": "@grainulation/grainulator-evidence",
  "version": "3.0.1",
  "description": "Research-driven development framework \u2014 structured claims, compiled evidence, deterministic output",
  "license": "MIT",
  "author": "grainulation contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grainulation/grainulator.git"
  },
  "homepage": "https://grainulator.dev",
  "bugs": {
    "url": "https://github.com/grainulation/grainulator/issues"
  },
  "keywords": [
    "evidence-framework",
    "research-sprint",
    "claims-compiler",
    "claude-code",
    "structured-research",
    "evidence-graded",
    "decision-framework",
    "research-driven-development",
    "developer-research",
    "technical-decision-making"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./compiler": "./lib/compiler.js",
    "./guard": "./lib/guard.js",
    "./load-claims": "./lib/load-claims.js"
  },
  "files": [
    "bin/",
    "lib/",
    "compiler/",
    "templates/",
    "README.md",
    "LICENSE",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/cli.test.js test/compiler.test.js test/guard.test.js test/init.test.js test/migration.test.js test/mcp.test.js test/claims-ops.test.js test/load-claims.test.js test/status.test.js test/tarball.test.js test/passages.test.js",
    "format": "npx prettier@3.3 --write .",
    "format:check": "npx prettier@3.3 --check ."
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@grainulation/grainulator-shared": "3.0.1"
