		"url": "https://github.com/grainulation/grainulator/issues"
	},
	"scripts": {
		"build": "node scripts/check-surface.mjs",
		"test": "node scripts/test-workspace.mjs",
		"test:e2e": "npm run test:install",
		"test:all": "npm test && npm run test:runtime && npm run test:reports && npm run test:install",
		"build:identity": "node scripts/build-identity.mjs",
		"sync-version": "node scripts/sync-version.js",
		"version": "node scripts/sync-version.js && npx --yes @biomejs/biome format --write .claude-plugin/ .codex-plugin/ plugin.json && git add .claude-plugin/plugin.json .claude-plugin/marketplace.json .codex-plugin/plugin.json plugin.json",
		"test:plugin": "node --test test/*.test.js",
		"test:core": "node --test test/dogfood/*.test.mjs",
		"dogfood": "node bin/grainulator.js",
		"check:package": "node scripts/check-package.mjs",
		"pack:local": "node scripts/pack-local.mjs",
		"lint": "biome check .",
		"test:runtime": "npm run test:conformance --workspace @grainulation/grainulator-runtime",
		"test:install": "node scripts/package-isolation-check.mjs",
		"test:distribution": "node --test migration/*.test.mjs scripts/homebrew*.test.mjs scripts/package-native.test.mjs",
		"check:surface": "node scripts/check-surface.mjs && node scripts/generate-reference.mjs --check",
		"test:reports": "node scripts/audit-render-check.mjs"
	},
	"engines": {
		"node": ">=24"
	},
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"bin": {
		"grainulator": "bin/grainulator.js"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"playwright": "1.65.1"
	}
}
